# ---------------------------------------------------------------------------
# TinyFish (mandatory integration). Get a key at https://agent.tinyfish.ai/api-keys
# The key is ONLY ever used server-side. It is never sent to the browser.
# ---------------------------------------------------------------------------
TINYFISH_API_KEY=

# Where the TinyFish remote browser can reach this server.
# Needed so the live web agent can reach the bundled demo portals.
# `npm run tunnel` (cloudflared quick tunnel) prints a URL like
# https://random-words.trycloudflare.com -> put it here.
PUBLIC_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATA_DIR=.data

# Country used to pick the right official portals. IN = India.
DEFAULT_COUNTRY=IN
DEFAULT_LANG=en

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# A report is NEVER written to a server-side store. It lives in the running
# process's memory and disappears with it. Set RECLAIM_PERSIST=1 only for local
# experiments, if you want a SQLite copy to look at. Never set it on a
# deployment.
RECLAIM_PERSIST=0

# Even so, the API keeps a working copy in memory while you are on the page.
# The tab tells it to forget the moment the page hides; if that signal never
# arrives, this sweep is the backstop: minutes of inactivity before the copy
# and its uploaded evidence bytes are dropped.
RECLAIM_FORGET_MINUTES=30

# ---------------------------------------------------------------------------
# Optional: LLM provider for narrative drafting + low-confidence disambiguation.
# If unset, the app uses deterministic template drafting and the local classifier.
# OpenAI-compatible endpoint (works with OpenRouter, Groq, Together, Ollama...).
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# Optional: speech-to-text, used by the voice-note button.
# Any OpenAI-compatible endpoint that serves POST /audio/transcriptions works -
# Groq (https://api.groq.com/openai/v1) with whisper-large-v3 is the quickest.
# Leave LLM_API_KEY empty and the voice button says so instead of failing.
# ---------------------------------------------------------------------------
STT_MODEL=whisper-large-v3
